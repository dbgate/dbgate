    {
      "match": "top.*customer.*order|customer.*most.*order|most.*order.*today",
      "steps": [
        {
          "type": "tool_calls",
          "tool_calls": [
            { "name": "get_databases", "arguments": { "filter": "AiCustomer" } }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            { "name": "get_tables", "arguments": { "database_name": "AiCustomerNorth" } }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            {
              "name": "get_table_schema",
              "arguments": {
                "database_name": "AiCustomerNorth",
                "schema_name": "dbo",
                "table_name": "Orders"
              }
            }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            {
              "name": "execute_server_sql",
              "arguments": {
                "sql": "SET NOCOUNT ON; DECLARE @sql nvarchar(max); SELECT @sql = STRING_AGG(CONVERT(nvarchar(max), N'SELECT ' + QUOTENAME(name, '''') + N' AS customer_database, COUNT(*) AS order_count FROM ' + QUOTENAME(name) + N'.[dbo].[Orders] WHERE [CreatedAt] >= CONVERT(date, SYSDATETIME()) AND [CreatedAt] < DATEADD(day, 1, CONVERT(date, SYSDATETIME()))'), N' UNION ALL ') FROM sys.databases WHERE state_desc = N'ONLINE' AND HAS_DBACCESS(name) = 1 AND name LIKE N'AiCustomer%'; SET @sql = N'SELECT TOP (5) customer_database, order_count FROM (' + @sql + N') AS customer_orders ORDER BY order_count DESC, customer_database;'; EXEC sys.sp_executesql @sql;"
              }
            }
          ]
        },
        {
          "type": "text",
          "content": "AiCustomerNorth has the most orders today with 7, followed by AiCustomerWest with 5 and AiCustomerSouth with 3."
        }
      ]
    },
    {
      "match": "how many.*order.*AiCustomerNorth|order.*AiCustomerNorth.*today",
      "steps": [
        {
          "type": "tool_calls",
          "tool_calls": [
            { "name": "get_databases", "arguments": { "filter": "AiCustomerNorth" } }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            { "name": "get_tables", "arguments": { "database_name": "AiCustomerNorth" } }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            {
              "name": "get_table_schema",
              "arguments": {
                "database_name": "AiCustomerNorth",
                "schema_name": "dbo",
                "table_name": "Orders"
              }
            }
          ]
        },
        {
          "type": "tool_calls",
          "tool_calls": [
            {
              "name": "execute_database_sql",
              "arguments": {
                "database_name": "AiCustomerNorth",
                "sql": "SET NOCOUNT ON; SELECT COUNT(*) AS order_count FROM [dbo].[Orders] WHERE [CreatedAt] >= CONVERT(date, SYSDATETIME()) AND [CreatedAt] < DATEADD(day, 1, CONVERT(date, SYSDATETIME()));"
              }
            }
          ]
        },
        {
          "type": "text",
          "content": "AiCustomerNorth has 7 orders today."
        }
      ]
    },
    {
      "match": "Explain the following error|doesn't exist|does not exist",
      "steps": [
        {
          "type": "tool_calls",
          "tool_calls": [
            { "name": "get_table_schema", "arguments": { "table": "Invoice" } }
          ]
        },
        {
          "type": "text",
          "content": "The error occurs because the table `Invoice2` does not exist in the `MyChinook` database. The correct table name is `Invoice`. Here is the corrected query:\n\n```sql\nSELECT * FROM Invoice\n```\n\nThe table name had a typo — `Invoice2` instead of `Invoice`. The `Invoice` table contains columns like `InvoiceId`, `CustomerId`, `InvoiceDate`, `Total`, and billing address fields."
        }
      ]
    }
