{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": false,
    "types": ["*"],
    "preserveWatchOutput": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}
