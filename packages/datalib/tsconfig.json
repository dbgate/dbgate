{
    "compilerOptions": {
      "target": "ES2015",
      "module": "commonjs",
      "declaration": true,
      "skipLibCheck": true,
      "outDir": "lib",
      "rootDir": "src",
      "strict": false,
      "types": ["*"],
      "esModuleInterop": true,
      "preserveWatchOutput": true
    },
    "include": [
      "src/**/*"
    ]
  }